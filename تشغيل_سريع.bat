@echo off
chcp 65001 > nul
title عرض كتاب قانون الأعمال - تشغيل سريع
cd /d "%~dp0"

echo ======================================================================
echo   🏛️  عرض كتاب قانون الأعمال: إنهاء عقد العمل في القانون العراقي
echo ======================================================================
echo.

:: التحقق من وجود Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطأ] Node.js غير مثبت على جهازك!
    echo يرجى تحميل وتثبيت Node.js من الموقع الرسمي: https://nodejs.org
    echo.
    pause
    exit /b
)

:: التحقق من تثبيت الحزم والمكتبات
if not exist "node_modules\" (
    echo [*] مجلد المكتبات (node_modules) غير موجود.
    echo [*] جاري تثبيت المكتبات المطلوبة لأول مرة (npm install)...
    echo.
    call npm install
    if %errorlevel% neq 0 (
        echo [خطأ] حدثت مشكلة أثناء تثبيت المكتبات.
        pause
        exit /b
    )
    echo.
    echo [✓] تم تثبيت جميع الحزم بنجاح!
    echo.
)

echo [*] جاري تشغيل خادم العرض المحلي وفتح المتصفح تلقائياً...
echo [*] الرابط المحلي: http://localhost:5173
echo [*] الرابط السحابي المباشر: https://23-ivory-five.vercel.app
echo.
echo ======================================================================
echo   ملاحظة: لإيقاف الخادم، اضغط Ctrl + C ثم اختر Y
echo ======================================================================
echo.

:: تشغيل خادم Vite وفتح المتصفح تلقائياً
call npm run dev -- --open

pause
